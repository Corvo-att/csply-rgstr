# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="EGYCON Cosplayer Register"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Event dates/times are entered and shown in this timezone
APP_TIMEZONE=Africa/Cairo

# ── Database (MySQL — recommended default) ───────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=con_register_db
DB_USERNAME=con_register_user
DB_PASSWORD=secret

# ── Database (SQL Server — uncomment if required) ────────────────────────────
# DB_CONNECTION=sqlsrv
# DB_HOST=127.0.0.1
# DB_PORT=1433
# DB_DATABASE=con_register_db
# DB_USERNAME=sa
# DB_PASSWORD=secret

# ── Redis (Docker, port 6379) ─────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# ── Mail (placeholder) ────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="noreply@egycon.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── File storage ───────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
# Uploads go to storage/app/public/uploads - run "php artisan storage:link" once.
MEDIA_DISK=public

# ── Video processing (needs ffmpeg + ffprobe installed on the server) ─────────
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# true in production: refuse video uploads if ffmpeg is missing, so unchecked videos never reach the show
MEDIA_REQUIRE_FFMPEG=false
# Videos are processed by a queue worker:  php artisan queue:work

# ── EGYCON Voting integration ─────────────────────────────────────────────────
# Shared secret the voting system sends as "Authorization: Bearer <token>". Empty = API off.
# Generate one with:  php -r "echo bin2hex(random_bytes(32));"
VOTING_API_TOKEN=

# ── PHP limits (php.ini) - uploads can never exceed these, whatever the form says ──
# upload_max_filesize = 512M
# post_max_size       = 520M
